{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custom RAG",
  "identifier": "com.customrag.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Custom RAG",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": ["binaries/ragcore"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3NkE4QzQwQjgwQUFFRkEKUldUNnJncTRRSXhxeDdJdzVBK2d4d1hHQXhjdUdzanJpdmZqRHB3a2dlNUlORUlFa0xUY3RWTlQK",
      "endpoints": [
        "https://github.com/GabryeleSantoro/custom-rag/releases/latest/download/latest.json"
      ]
    }
  }
}
